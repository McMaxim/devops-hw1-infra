<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>nginx by Terraform</title></head>
<body>
  <h1>nginx is up (managed by Terraform)</h1>
  <ul>
    <li>container: ${container_name}</li>
    <li>network: ${network_name}</li>
    <li>volume: ${volume_name}</li>
    <li>published port: ${external_port}</li>
  </ul>
</body>
</html>
